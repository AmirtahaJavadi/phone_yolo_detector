# Dockerfile.gpu - NVIDIA GPU version
# Uses CUDA-enabled PyTorch. Requires nvidia-container-toolkit on the host.
#
# Host prerequisites:
#   sudo apt install -y nvidia-container-toolkit
#   sudo systemctl restart docker
#
# Run via: docker compose -f docker-compose.yml -f docker-compose.gpu.yml run --rm ros2

FROM osrf/ros:humble-desktop

LABEL maintainer="user <user@example.com>"
LABEL description="ROS 2 Humble + Ultralytics YOLO with CUDA support"

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV QT_X11_NO_MITSHM=1
ENV ROS_LOCALHOST_ONLY=0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# ---- System dependencies (apt) ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-rqt-image-view \
        ros-${ROS_DISTRO}-image-pipeline \
        python3-pip \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-argcomplete \
        libgl1 \
        libglib2.0-0 \
        vim \
        git \
        wget \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
             (rosdep init || true) && rosdep update"

# ---- Python ML deps with CUDA 11.8 build of PyTorch ----
# PyTorch wheel with CUDA 11.8 matches most modern NVIDIA drivers (>=525).
RUN pip3 install --no-cache-dir \
        torch torchvision --index-url https://download.pytorch.org/whl/cu118

RUN pip3 install --no-cache-dir \
        ultralytics opencv-python-headless

# ---- Workspace ----
SHELL ["/bin/bash", "-c"]
WORKDIR /ros2_ws
ENV YOLO_CONFIG_DIR=/root/.config/Ultralytics

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
